# Frontend API base and local Vite proxy
VITE_API_BASE_URL=/api
VITE_LOCAL_API_TARGET=http://localhost:4000

# Local websocket endpoint; VITE_API_URL is used as a fallback by the audit view
VITE_API_URL=http://localhost:4000
VITE_SECURITY_WS_URL=ws://localhost:4000/ws/security

# Set only for the Vercel serverless API proxy deployment.
BACKEND_URL=
