{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend && npm ci --prefix backend",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "^/api(/.*)$",
      "dest": "/api$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
