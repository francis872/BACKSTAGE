# Copia a backend/.env y reemplaza estos valores localmente. Nunca los subas a Git.
MONGODB_URI=
MONGODB_SPATIAL_DB=backstage_spatial
SPATIAL_STORE=atlas
JWT_SECRET=
JWT_ISSUER=backstage-intelligence
JWT_AUDIENCE=backstage-platform
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_LOCAL_API_TARGET=http://localhost:4000

# SOI e identidad usan MongoDB por defecto (Atlas o replica set).
# Python con bsie/requirements.txt instalado; vacío detecta .venv-bsie.
BSIE_PYTHON=

# Secretos solo del servidor: protección de operaciones PH y secretos TOTP.
# Ver docs/BACKSTAGE_NATIVE_TRUST_ARCHITECTURE.md para custodia y rotación.
HEBRA_ENCRYPTION_KEYS=
HEBRA_ACTIVE_KEY_ID=
