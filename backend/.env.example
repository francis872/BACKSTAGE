JWT_SECRET=
JWT_ISSUER=backstage-intelligence
JWT_AUDIENCE=backstage-platform
BCRYPT_ROUNDS=12
SPATIAL_STORE=atlas
MONGODB_URI=
MONGODB_SPATIAL_DB=backstage_spatial
MONGODB_APP_NAME=backstage
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
JSON_BODY_LIMIT=5mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SPATIAL_TILE_CACHE_MAX=500
SPATIAL_TILE_CACHE_TTL_MS=300000
OPERATIONAL_SUPERVISOR_INTERVAL_MS=300000
AUTO_RECOVERY_MAX_ATTEMPTS=3
AUTO_RECOVERY_BASE_COOLDOWN_MS=900000
AUTO_RECOVERY_MAX_COOLDOWN_MS=21600000
AUTO_RECOVERY_CIRCUIT_FAILURE_THRESHOLD=2
AUTO_RECOVERY_CIRCUIT_OPEN_MS=3600000
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Fuentes públicas para desarrollo o uso personal (Open-Meteo requiere plan para uso comercial).
OPEN_METEO_API_KEY=
OVERPASS_URL=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=BACKSTAGE/3.1 (https://backstage-web-seven.vercel.app)

# SOI: proveedores públicos de desarrollo; producción necesita condiciones/capacidad autorizadas.
SOI_OSRM_DRIVING_URL=https://router.project-osrm.org
# Configurar servidores realmente preprocesados con los perfiles correspondientes.
SOI_OSRM_WALKING_URL=
SOI_OSRM_CYCLING_URL=
# Endpoint Photon autorizado; vacío mantiene solo búsqueda explícita.
SOI_PHOTON_URL=
# Sugerencias autorizadas Mapbox. Solo servidor; nunca VITE_ ni claves en el repositorio.
# Activar permanent solo con almacenamiento permanente habilitado en la cuenta.
MAPBOX_ACCESS_TOKEN=
MAPBOX_GEOCODING_PERMANENT=false
# Correo transaccional de acceso. No habilitar sin remitente verificado y origen HTTPS propio.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_PUBLIC_APP_URL=
# Mantener contrato y procedencia Copernicus GLO-90 en cualquier endpoint alternativo.
SOI_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
SOI_GPS_RETENTION_DAYS=30

# SOI e identidad usan MongoDB por defecto (Atlas o replica set).
# Python con bsie/requirements.txt instalado; vacío detecta .venv-bsie.
BSIE_PYTHON=

# Operación alojada: definir explícitamente al provisionar cada entorno.
# No configurar production sobre la conexión de pruebas.
BACKSTAGE_RUNTIME_ENV=
# Huellas de host/base (sin usuario/clave) registradas durante el provisionamiento.
BACKSTAGE_STAGING_TARGET_SHA256=
BACKSTAGE_PRODUCTION_TARGET_SHA256=
MONITOR_API_ORIGIN=
MONITOR_WEB_ORIGIN=
MONITOR_EXPECT_PROTECTION=
MONITOR_VERCEL_BYPASS=
# GPS: cada integración referencia su configuración propia y secreto en servidor.
# SOI_CONNECTOR_FLOTA={"organization_id":123,"provider":"traccar","url":"https://gps.example.invalid","fleet_source_id":456,"device_map":{"DEVICE_ID":789},"token_env":"SOI_CONNECTOR_FLOTA_TOKEN"}
# SOI_CONNECTOR_FLOTA_TOKEN=

# Protección nativa: configurar mediante secretos del servidor, nunca en VITE_*.
# Objeto JSON de identificadores a claves aleatorias de 32 bytes en base64 canónico.
# Vacío deshabilita escrituras sensibles y nuevas activaciones MFA; no hay clave por defecto.
# Conservar claves anteriores mientras existan datos cifrados que las requieran.
HEBRA_ENCRYPTION_KEYS=
HEBRA_ACTIVE_KEY_ID=
